generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ---- Enumy: integralność danych na poziomie bazy ---- */

enum OrderStatus {
  NEW
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Platform {
  REACT_NATIVE
  IONIC
}

enum Scenario {
  S1
  S2
  S3
}

/// Każda wartość = jedno miejsce pomiaru w kodzie aplikacji (patrz MetricName
/// w src/core/measure.ts po stronie obu aplikacji).
enum MetricType {
  STARTUP_MS
  UI_RESPONSE_MS
  API_REQUEST_MS
  REQUEST_BUILD_MS
  RENDER_CHECKOUT_MS
  RENDER_ORDERS_MS
  RENDER_SEARCH_MS
  RAM_MB
  CPU_PERCENT
}

enum BuildType {
  DEBUG
  RELEASE
}

model Category {
  id        String    @id @db.VarChar(16)
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(80)
  sortOrder Int       @default(0)
  services  Service[]

  @@map("categories")
}

model Service {
  id           String   @id @db.VarChar(16)
  name         String   @db.VarChar(160)
  description  String   @db.Text
  categoryId   String   @db.VarChar(16)
  category     Category @relation(fields: [categoryId], references: [id])
  priceCents   Int              // pieniądze zawsze jako liczba całkowita (grosze)
  deliveryTime String   @db.VarChar(32)
  imageUrl     String   @db.VarChar(255)   // ścieżka względna: /static/images/srv_001.jpg
  rating       Float
  sortOrder    Int      @default(0)        // gwarantuje STAŁĄ kolejność listy

  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([sortOrder])
  @@map("services")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(120)
  passwordHash String   @db.VarChar(72)
  fullName     String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  orders       Order[]

  @@map("users")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName  String      @db.VarChar(100)
  customerEmail String      @db.VarChar(120)
  totalCents    Int
  status        OrderStatus @default(NEW)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  items         OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId      String  @db.VarChar(16)
  service        Service @relation(fields: [serviceId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@map("order_items")
}

/// Tabela wyników pomiarów — serce infrastruktury badawczej
model Measurement {
  id           Int        @id @default(autoincrement())
  sessionId    String     @db.VarChar(32)
  runId        String     @db.VarChar(64) // <sessionId>_<scenario>
  platform     Platform
  scenario     Scenario
  metric       MetricType
  iteration    Int
  value        Float
  unit         String     @db.VarChar(8) // "ms" | "MB" | "%"
  deviceModel  String?    @db.VarChar(80)
  osVersion    String?    @db.VarChar(40)
  buildType    BuildType? // MUSI być RELEASE
  appVersion   String?    @db.VarChar(20)
  serverMs     Float? // z nagłówka Server-Timing
  extra        Json? // JSONB — można odpytywać w SQL
  /// Epoch ms z urządzenia. Zamiast timestamptz, bo sterownik zapisywał tam
  /// moment przesunięty o offset strefy. Tego używaj do łączenia z RAM/CPU.
  recordedAtMs BigInt
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([sessionId, platform, scenario, metric])
  @@map("measurements")
}