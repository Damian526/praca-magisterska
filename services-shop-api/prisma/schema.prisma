generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ---- Enumy: integralność danych na poziomie bazy ---- */

enum OrderStatus {
  NEW
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Platform {
  REACT_NATIVE
  IONIC
}

enum Scenario {
  S1
  S2
  S3
}

enum MetricType {
  STARTUP_MS
  UI_RESPONSE_MS
  API_REQUEST_MS
  RENDER_MS
  RAM_MB
  CPU_PERCENT
}

enum BuildType {
  DEBUG
  RELEASE
}

model Category {
  id        String    @id @db.VarChar(16)
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(80)
  sortOrder Int       @default(0)
  services  Service[]

  @@map("categories")
}

model Service {
  id           String   @id @db.VarChar(16)
  name         String   @db.VarChar(160)
  description  String   @db.Text
  categoryId   String   @db.VarChar(16)
  category     Category @relation(fields: [categoryId], references: [id])
  priceCents   Int              // pieniądze zawsze jako liczba całkowita (grosze)
  deliveryTime String   @db.VarChar(32)
  imageUrl     String   @db.VarChar(255)   // ścieżka względna: /static/images/srv_001.jpg
  rating       Float
  sortOrder    Int      @default(0)        // gwarantuje STAŁĄ kolejność listy

  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([sortOrder])
  @@map("services")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(120)
  passwordHash String   @db.VarChar(72)
  fullName     String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  orders       Order[]

  @@map("users")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName  String      @db.VarChar(100)
  customerEmail String      @db.VarChar(120)
  totalCents    Int
  status        OrderStatus @default(NEW)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  items         OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId      String  @db.VarChar(16)
  service        Service @relation(fields: [serviceId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@map("order_items")
}

/// Tabela wyników pomiarów — serce infrastruktury badawczej
model Measurement {
  id          Int        @id @default(autoincrement())
  runId       String     @db.VarChar(64)   // identyfikator serii pomiarowej
  platform    Platform                     // enum: REACT_NATIVE | IONIC
  scenario    Scenario                     // enum: S1 | S2 | S3
  metric      MetricType                   // enum: STARTUP_MS | ...
  iteration   Int                          // numer powtórzenia 1..30
  value       Float                        // zmierzona wartość
  unit        String     @db.VarChar(8)    // "ms" | "MB" | "%"
  deviceModel String?    @db.VarChar(80)
  osVersion   String?    @db.VarChar(40)
  buildType   BuildType?                   // MUSI być RELEASE
  appVersion  String?    @db.VarChar(20)
  serverMs    Float?                       // czas serwera z nagłówka Server-Timing
  extra       Json?                        // JSONB — można odpytywać w SQL
  recordedAt  DateTime   @db.Timestamptz(3)  // czas na urządzeniu
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([runId, platform, scenario, metric])
  @@map("measurements")
}